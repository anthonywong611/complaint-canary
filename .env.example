# Copy to .env. Placeholders only: never commit real values.

# --- Docker Compose (local) ---
# Password for the local Postgres container that stores Dagster's run history.
DAGSTER_PG_PASSWORD=change-me

# --- Pipeline (all optional locally; defaults run the bundled fixture on DuckDB) ---
CANARY_ENV=local
CANARY_WAREHOUSE=duckdb
# CANARY_DUCKDB_PATH=data/warehouse.duckdb
# CANARY_LANDING_URI=data/landing

# Sources: an https URL or a local file. Leave unset to use the real public sources.
CANARY_CFPB_URL=data/fixture/day1/complaints.csv.zip
CANARY_FDIC_URL=data/fixture/fdic_institutions.json
CANARY_CENSUS_URL=data/fixture/census_state_population.csv

# Percentage of complaints to keep (stable sample). 100 = everything.
CANARY_SAMPLE_PERCENT=100
# Let a snapshot through the row-count and delete-guard checks once. See docs/runbook.md.
CANARY_GATE_OVERRIDE=false

# --- Cloud only (written to the VM by Terraform; listed here for reference) ---
# CANARY_WAREHOUSE=bigquery
# CANARY_GCP_PROJECT=your-project-id
# CANARY_BQ_LOCATION=US
# CANARY_DATASET_PREFIX=canary_dev_
# CANARY_LANDING_URI=gs://your-landing-bucket
# CANARY_EVENT_SINK=cloud_logging
# CANARY_ENABLE_SCHEDULES=false
# CANARY_SCD2_BACKUP_ENABLED=false
# CANARY_DBT_FULL_REFRESH=false
# CANARY_ZIP_POLICY_TAG=projects/your-project-id/locations/us/taxonomies/000/policyTags/000
